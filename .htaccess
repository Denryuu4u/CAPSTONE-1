# Friendly error pages for LOCAL XAMPP (app served under /CAPSTONE-1).
# On Railway the app is at "/" and .htaccess overrides are disabled, so this file
# is ignored there — production error pages come from apache-errors.conf (see the
# Dockerfile). Routes Apache's raw 404/403/500 to the branded error.php.
ErrorDocument 400 /CAPSTONE-1/error.php
ErrorDocument 403 /CAPSTONE-1/error.php
ErrorDocument 404 /CAPSTONE-1/error.php
ErrorDocument 500 /CAPSTONE-1/error.php

<IfModule php_module>
    php_flag display_errors Off
    php_flag display_startup_errors Off
    php_flag log_errors On
</IfModule>

# Design images are served only through the authenticated PHP endpoint.
<IfModule mod_rewrite.c>
    RewriteEngine On
    RewriteRule ^uploads/project-designs/ - [F,L]
</IfModule>
# DEV_MODE is configured by the environment, never enabled in this tracked file.
