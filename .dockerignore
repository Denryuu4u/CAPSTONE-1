# Keep the image small and free of local-only cruft.
.git
.gitignore
CLAUDE.md

# Schema, seed and setup scripts are run from a developer machine, never
# served — keep them (and the seeded password hashes) off the web server.
database/

# Don't bake local uploads into the image (they're ephemeral anyway; use a
# Railway volume mounted at uploads/ for persistence). Keep the folders.
uploads/*
!uploads/.gitkeep
!uploads/gallery/
uploads/gallery/*
!uploads/gallery/.gitkeep
